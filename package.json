{
	"name": "hrsn",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"deploy": "bun run build && wrangler deploy"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-dsv": "^4.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/lodash": "^4.17.27",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"wrangler": "^4.153.0"
	},
	"dependencies": {
		"iconify-icon": "^3.0.4",
		"lodash": "^4.18.1"
	},
	"imports": {
		"#data/*": "./src/data/*",
		"#components/*": "./src/components/*",
		"#assets/*": "./src/assets/*"
	}
}
